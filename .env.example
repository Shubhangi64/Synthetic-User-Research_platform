# Provider: ollama, gemini, or demo
LLM_PROVIDER=ollama

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# App
API_URL=http://localhost:8000
MAX_PERSONAS=4
DEFAULT_PERSONAS=4

# Ollama performance controls
OLLAMA_TIMEOUT_SECONDS=360
OLLAMA_NUM_PREDICT=500
